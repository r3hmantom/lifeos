{
  "version": "1.0.0",
  "baseUrl": "https://api.lifeos.app/v1",
  "description": "API Specification for LifeOS Mobile App",
  "models": {
    "User": {
      "id": "string (uuid)",
      "email": "string",
      "name": "string",
      "avatarUrl": "string (optional)"
    },
    "AuthResponse": {
      "user": "User",
      "token": "string (jwt)",
      "refreshToken": "string"
    },
    "Memory": {
      "id": "string (uuid)",
      "title": "string",
      "description": "string",
      "tags": "string[]",
      "date": "string (ISO 8601 date)",
      "isActive": "boolean"
    },
    "Goal": {
      "id": "string (uuid)",
      "title": "string",
      "focus": "string (category e.g., Career, Health)",
      "deadline": "string",
      "priority": "string (High | Medium | Low)",
      "isActive": "boolean"
    },
    "ScheduleItem": {
      "id": "string (uuid)",
      "title": "string",
      "description": "string (optional)",
      "startTime": "string (ISO 8601 datetime)",
      "endTime": "string (ISO 8601 datetime)",
      "type": "string (fixed_commitment | goal_task | routine | other)",
      "relatedId": "string (optional, id of related memory or goal)",
      "isCompleted": "boolean"
    },
    "ScheduleGenerationRequest": {
      "timezone": "string",
      "date": "string (YYYY-MM-DD, optional, defaults to today)",
      "preferences": {
        "startOfDay": "string (HH:mm)",
        "endOfDay": "string (HH:mm)"
      }
    },
    "UserSettings": {
      "id": "string (uuid)",
      "userId": "string (uuid)",
      "theme": "string (light | dark | system)",
      "notificationsEnabled": "boolean",
      "timezone": "string",
      "updatedAt": "string (ISO datetime)"
    },

    "TimetableSlot": {
      "id": "string (uuid)",
      "userId": "string (uuid)",
      "time": "string (HH:mm)",
      "activity": "string",
      "isActive": "boolean",
      "createdAt": "string (ISO datetime)",
      "updatedAt": "string (ISO datetime)"
    },

    "TimetableTemplateResponse": {
      "data": "TimetableSlot[]"
    }
  },
  "endpoints": {
    "auth": {
      "login": {
        "method": "POST",
        "path": "/auth/login",
        "description": "Authenticate existing user",
        "body": {
          "email": "string",
          "password": "string"
        },
        "response": "AuthResponse"
      },
      "register": {
        "method": "POST",
        "path": "/auth/register",
        "description": "Register new user",
        "body": {
          "name": "string",
          "email": "string",
          "password": "string"
        },
        "response": "AuthResponse"
      }
    },
    "memories": {
      "getAll": {
        "method": "GET",
        "path": "/memories",
        "description": "Get all user memories (fixed commitments like university schedule)",
        "headers": {
          "Authorization": "Bearer <token>"
        },
        "response": {
          "data": "Memory[]"
        }
      },
      "create": {
        "method": "POST",
        "path": "/memories",
        "description": "Create a new memory/commitment",
        "headers": {
          "Authorization": "Bearer <token>"
        },
        "body": {
          "title": "string",
          "description": "string",
          "tags": "string[]",
          "date": "string (ISO 8601 date)"
        },
        "response": "Memory"
      }
    },
    "goals": {
      "getAll": {
        "method": "GET",
        "path": "/goals",
        "description": "Get all user goals",
        "headers": {
          "Authorization": "Bearer <token>"
        },
        "response": {
          "data": "Goal[]"
        }
      },
      "create": {
        "method": "POST",
        "path": "/goals",
        "description": "Create a new goal",
        "headers": {
          "Authorization": "Bearer <token>"
        },
        "body": {
          "title": "string",
          "focus": "string",
          "deadline": "string",
          "priority": "string (High | Medium | Low)"
        },
        "response": "Goal"
      }
    },
    "schedule": {
      "getDaily": {
        "method": "GET",
        "path": "/schedule",
        "description": "Get the generated schedule for a specific date",
        "headers": {
          "Authorization": "Bearer <token>"
        },
        "queryParams": {
          "date": "string (YYYY-MM-DD, optional)"
        },
        "response": {
          "date": "string (YYYY-MM-DD)",
          "items": "ScheduleItem[]"
        }
      },
      "generate": {
        "method": "POST",
        "path": "/schedule/generate",
        "description": "Trigger AI to generate a schedule based on Goals and Memories. This is the one-time call user makes from Dashboard.",
        "headers": {
          "Authorization": "Bearer <token>"
        },
        "body": "ScheduleGenerationRequest",
        "response": {
          "message": "string (e.g., 'Schedule generated successfully')",
          "schedule": {
            "date": "string (YYYY-MM-DD)",
            "items": "ScheduleItem[]"
          }
        }
      }
    },
    "settings": {
      "get": {
        "method": "GET",
        "path": "/settings",
        "headers": { "Authorization": "Bearer <token>" },
        "response": "UserSettings"
      },
      "update": {
        "method": "PATCH",
        "path": "/settings",
        "headers": { "Authorization": "Bearer <token>" },
        "body": {
          "theme": "string (optional)",
          "notificationsEnabled": "boolean (optional)",
          "timezone": "string (optional)"
        },
        "response": "UserSettings"
      }
    },

    "timetable": {
      "getAll": {
        "method": "GET",
        "path": "/timetable",
        "headers": { "Authorization": "Bearer <token>" },
        "response": "TimetableTemplateResponse"
      },
      "create": {
        "method": "POST",
        "path": "/timetable",
        "headers": { "Authorization": "Bearer <token>" },
        "body": {
          "time": "string",
          "activity": "string",
          "isActive": "boolean"
        },
        "response": "TimetableSlot"
      },
      "update": {
        "method": "PATCH",
        "path": "/timetable/{id}",
        "headers": { "Authorization": "Bearer <token>" },
        "body": {
          "time": "string (optional)",
          "activity": "string (optional)",
          "isActive": "boolean (optional)"
        },
        "response": "TimetableSlot"
      },
      "delete": {
        "method": "DELETE",
        "path": "/timetable/{id}",
        "headers": { "Authorization": "Bearer <token>" },
        "response": { "message": "Slot deleted" }
      }
    }
  }
}
